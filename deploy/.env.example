# EMS 개발 서버 시크릿 템플릿.
# EC2에서 이 파일을 복사해 .env로 만들고 실제 값을 채운다.
#   cp .env.example .env  &&  vi .env
# .env는 절대 커밋하지 않는다.

# MySQL 애플리케이션 계정(ems) 비밀번호 — backend와 mysql이 공유
DB_PASSWORD=change-me

# MySQL root 비밀번호 (컨테이너 초기화용)
DB_ROOT_PASSWORD=change-me-root

# JWT 서명 시크릿 — 최소 32바이트 이상 랜덤 문자열 (미설정 시 백엔드 기동 실패)
# 생성 예: openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-long-random-secret

# ── 운영자(PLATFORM_ADMIN) 최초 부트스트랩 ────────────────────────────────
# 서버의 PlatformAdminInitializer가 기동 시 표준 역할 → 시스템 테넌트 → 운영자 계정을
# 순서대로 생성한다. 이미 있으면 건너뛰므로(멱등) 재기동해도 중복 생성되지 않는다.
#
# 사용 순서:
#   1) 아래 USERNAME/PASSWORD를 채우고 ENABLED=true 로 바꾼다
#   2) .\deploy\redeploy-backend.ps1 실행 (compose는 up 시점에 이 파일을 읽는다)
#   3) 로그에서 계정 생성 확인
#   4) ENABLED=false 로 되돌리고 docker compose up -d backend
#
# ENABLED=true 라도 USERNAME/PASSWORD가 비어 있으면 경고만 남기고 건너뛴다.
PLATFORM_BOOTSTRAP_ENABLED=true
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=platform!1234
PLATFORM_ADMIN_NAME=운영자
PLATFORM_ADMIN_EMAIL=ems@ems.com
PLATFORM_ADMIN_DEPARTMENT=운영자
PLATFORM_ADMIN_TEL=

# 운영자가 속할 시스템 테넌트. bizNumber는 하이픈 없는 10자리이며 기존 테넌트와 겹치면 안 된다.
PLATFORM_SYSTEM_TENANT_NAME=플랫폼
PLATFORM_SYSTEM_TENANT_BIZ=0000000000
