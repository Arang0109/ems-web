# EMS 개발 서버 시크릿 템플릿.
# EC2에서 이 파일을 복사해 .env로 만들고 실제 값을 채운다.
#   cp .env.example .env  &&  vi .env
# .env는 절대 커밋하지 않는다.

# MySQL 애플리케이션 계정(ems) 비밀번호 — backend와 mysql이 공유
DB_PASSWORD=change-me

# MySQL root 비밀번호 (컨테이너 초기화용)
DB_ROOT_PASSWORD=change-me-root

# JWT 서명 시크릿 — 최소 32바이트 이상 랜덤 문자열 (미설정 시 백엔드 기동 실패)
# 생성 예: openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-long-random-secret

# 토큰 수명(밀리초). 미설정 시 compose 기본값(AT 1시간 / RT 7시간)이 쓰인다.
# RT_VALID 는 항상 AT_VALID 보다 길어야 한다 — 짧으면 재발급이 먼저 만료된다.
#   1시간=3600000  7시간=25200000  10시간=36000000  24시간=86400000
AT_VALID=36000000
RT_VALID=86400000

# Refresh Token 쿠키 정책. HTTP 접속이면 반드시 false/Lax — secure 쿠키는 HTTPS 응답에서만
# 브라우저에 저장되므로, http 로 켠 채 true 로 두면 로그인 직후 쿠키가 버려져 재발급이 안 된다.
# HTTPS 도메인으로 서비스할 때만 true / None 으로 올린다.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── 운영자(PLATFORM_ADMIN) 최초 부트스트랩 ────────────────────────────────
# 서버의 PlatformAdminInitializer가 기동 시 표준 역할 → 시스템 테넌트 → 운영자 계정을
# 순서대로 생성한다. 이미 있으면 건너뛰므로(멱등) 재기동해도 중복 생성되지 않는다.
#
# 사용 순서:
#   1) 아래 USERNAME/PASSWORD를 채우고 ENABLED=true 로 바꾼다
#   2) .\deploy\redeploy-backend.ps1 실행 (compose는 up 시점에 이 파일을 읽는다)
#   3) 로그에서 계정 생성 확인
#   4) ENABLED=false 로 되돌리고 docker compose up -d backend
#
# ENABLED=true 라도 USERNAME/PASSWORD가 비어 있으면 경고만 남기고 건너뛴다.
PLATFORM_BOOTSTRAP_ENABLED=true
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=platform!1234
PLATFORM_ADMIN_NAME=운영자
PLATFORM_ADMIN_EMAIL=ems@ems.com
PLATFORM_ADMIN_DEPARTMENT=운영자
PLATFORM_ADMIN_TEL=

# 운영자가 속할 시스템 테넌트. bizNumber는 하이픈 없는 10자리이며 기존 테넌트와 겹치면 안 된다.
PLATFORM_SYSTEM_TENANT_NAME=플랫폼
PLATFORM_SYSTEM_TENANT_BIZ=0000000000

# ── 브라우저 허용 오리진 (CORS + WebSocket 핸드셰이크) ────────────────────
# 쉼표로 구분한다. 프로토콜과 포트까지 정확히 적는다.
#
# 이 값을 빠뜨리면 REST 는 멀쩡한데 채팅만 붙지 않는다 — REST 는 nginx 를 통한 동일 오리진이라
# CORS 프리플라이트가 없지만, WebSocket 핸드셰이크는 동일 오리진이어도 Origin 헤더를 검사한다.
# 증상이 "채팅만 안 된다"로 나타나 프록시 문제로 오인하기 쉽다.
#
# 배포 호스트(EC2 퍼블릭 IP 또는 도메인)를 반드시 포함한다. 미설정 시 서버 기본값
# (localhost:5173 등 개발용)만 허용되므로 배포 환경에서는 사실상 필수다.
CORS_ALLOWED_ORIGINS=http://13.236.208.223,https://env-bridge.co.kr,https://www.env-bridge.co.kr
